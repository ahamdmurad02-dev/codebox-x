<Window x:Class="CodeBoxX.Views.MarketplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeBox X — Marketplace" Width="1180" Height="730" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Closing="MarketplaceWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Marketplace" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Installed" Click="Installed_Click" Margin="16,1,1,1" ToolTip="Open Extension Manager" />
                <TextBox x:Name="SearchBox" Grid.Column="3" AutomationProperties.Name="Marketplace Search" VerticalAlignment="Center" ToolTip="Search extensions" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="325" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="14">
                    <TextBlock Text="BROWSE" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <ListBox x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBoxItem Content="All Extensions" IsSelected="True" />
                        <ListBoxItem Content="Featured" />
                        <ListBoxItem Content="Popular" />
                        <ListBoxItem Content="Recently Added" />
                    </ListBox>
                    <Separator Margin="0,12" />
                    <TextBlock Text="TYPES" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <ListBox x:Name="TypeList" SelectionChanged="TypeList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBoxItem Content="Syntax Themes" />
                        <ListBoxItem Content="Linters" />
                        <ListBoxItem Content="Formatters" />
                        <ListBoxItem Content="Language Support" />
                        <ListBoxItem Content="Editor Tools" />
                        <ListBoxItem Content="Productivity" />
                    </ListBox>
                </StackPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
            <Grid Grid.Column="2" Background="{DynamicResource EditorBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="12,0">
                    <TextBlock x:Name="SectionTitleText" Text="All Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResultCountText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ExtensionList" Grid.Row="1" AutomationProperties.Name="Marketplace Extensions" Margin="8,0,8,8" Background="Transparent" BorderThickness="0" SelectionChanged="ExtensionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="2,3" Background="{DynamicResource PanelBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="  " /><TextBlock Text="{Binding Version}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" /></StackPanel>
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
            <Border Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="DetailNameText" Text="Select an extension" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailMetaText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailDescriptionText" Margin="0,16,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Permissions" FontWeight="SemiBold" Margin="0,22,0,5" />
                        <TextBlock x:Name="PermissionsText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <WrapPanel Margin="0,22,0,0">
                            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" Click="Install_Click" Margin="0,1,6,6" />
                            <Button x:Name="UninstallButton" Content="Uninstall" Click="Uninstall_Click" Margin="0,1,6,6" />
                            <Button x:Name="EnableButton" Content="Enable" Click="Enable_Click" Margin="0,1,6,6" />
                            <Button x:Name="UpdateButton" Content="Update" Click="Update_Click" Margin="0,1,6,6" />
                        </WrapPanel>
                        <Separator x:Name="ThemeSeparator" Margin="0,16" />
                        <TextBlock x:Name="ThemeActionsTitle" Text="Theme Actions" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="PreviewThemeButton" Content="Preview Theme" Click="PreviewTheme_Click" Margin="0,1,6,6" />
                            <Button x:Name="ApplyThemeButton" Content="Apply Theme" Style="{StaticResource AccentButton}" Click="ApplyTheme_Click" Margin="0,1,6,6" />
                            <Button x:Name="ResetThemeButton" Content="Reset Theme" Click="ResetTheme_Click" Margin="0,1,6,6" />
                        </WrapPanel>
                        <Border x:Name="ThemePreviewSwatch" Height="66" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,12,0,0" Padding="10">
                            <StackPanel><TextBlock Text="Theme Preview" FontWeight="SemiBold" /><TextBlock Text="Editor, sidebar, syntax, and terminal colors" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource AccentBrush}"><TextBlock x:Name="StatusText" Text="Local marketplace catalog" Foreground="White" VerticalAlignment="Center" Margin="12,0" FontSize="11" /></Border>
    </Grid>
</Window>
