<Window x:Class="CodeBoxX.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update CodeBox X" Width="610" Height="540" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Image Source="/Assets/CodeBoxX.png" Width="42" Height="42" Margin="0,0,12,0" DockPanel.Dock="Left" Stretch="Uniform" />
            <StackPanel>
                <TextBlock Text="Update CodeBox X" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Official GitHub Releases only" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,22,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Current version" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Latest version" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />

        <GroupBox Grid.Row="3" Header="Release notes" BorderBrush="{DynamicResource BorderBrush}">
            <TextBox x:Name="ReleaseNotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="10" />
        </GroupBox>

        <StackPanel Grid.Row="4" Margin="0,16,0,8">
            <ProgressBar x:Name="DownloadProgressBar" Height="7" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DownloadButton" Content="Download Update" Click="DownloadButton_Click" IsEnabled="False" MinWidth="140" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" MinWidth="96" Margin="9,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
