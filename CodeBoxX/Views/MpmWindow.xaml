<Window x:Class="CodeBoxX.Views.MpmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeBox X — MPM" Width="1060" Height="720" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Closing="MpmWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="155" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="MPM" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProviderText" Text="Project not detected" FontSize="11" /></Border><TextBlock x:Name="DetectedTypeText" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0" /></StackPanel>
                    <TextBlock x:Name="DetectedPathText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    <TextBlock x:Name="ProjectGuidanceText" Text="Add a supported project file or source file, then refresh MPM." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Add Project File" Click="AddProjectFile_Click" ToolTip="Create a supported Python, Node.js, or .NET project file in the workspace" /><Button Content="Restore" Click="Restore_Click" ToolTip="Restore dependencies recorded in .codebox-mpm.json" /><Button Content="Refresh MPM" Click="Refresh_Click" ToolTip="Scan the workspace, detect the project, and refresh dependencies" /></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" ToolTip="Package name: letters, numbers, dots, underscores, and hyphens only" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                <Button Grid.Column="1" Content="Search" Click="Search_Click" Margin="7,0,0,0" />
                <Button Grid.Column="2" Content="Package Info" Click="Info_Click" Margin="3,0,0,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Background="{DynamicResource SurfaceBrush}"><TextBlock x:Name="ListTitleText" Text="INSTALLED PACKAGES" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="12,0" DockPanel.Dock="Left" /><TextBlock x:Name="PackageCountText" Text="0 packages" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0" DockPanel.Dock="Right" /></DockPanel>
                    <ListBox x:Name="PackageList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="PackageList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="DetailNameText" Text="Select a package" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailVersionText" Grid.Row="1" Text="" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailSourceText" Grid.Row="2" Text="" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,14"><StackPanel><TextBlock x:Name="DetailDescriptionText" Text="Search a package or select an installed package to view its details." TextWrapping="Wrap" /><TextBlock x:Name="DetailCompatibilityText" Text="" Foreground="#B76E00" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></ScrollViewer>
                <StackPanel Grid.Row="4"><WrapPanel><Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" Click="Install_Click" /><Button x:Name="UninstallButton" Content="Uninstall" Click="Uninstall_Click" /><Button x:Name="UpdateButton" Content="Update" Click="Update_Click" /></WrapPanel><TextBlock Text="Installations require confirmation. Package scripts are disabled where supported." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
            </Grid></Border>
        </Grid>
        <GridSplitter Grid.Row="3" Height="5" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="4" Background="{DynamicResource TerminalBackgroundBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"><TextBlock Text="MPM OUTPUT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" DockPanel.Dock="Left" /><Button Content="Clear" Click="ClearOutput_Click" Margin="0,3,7,3" DockPanel.Dock="Right" /></DockPanel><TextBox x:Name="ProgressBox" Grid.Row="1" IsReadOnly="True" Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalTextBrush}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,5" /></Grid></Border>
        <Border Grid.Row="5" Background="{DynamicResource AccentBrush}"><TextBlock x:Name="StatusText" Text="MPM ready." Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="10,0" /></Border>
    </Grid>
</Window>
