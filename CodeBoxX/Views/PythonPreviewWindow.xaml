<Window x:Class="CodeBoxX.Views.PythonPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeBox X — Python Live Preview" Width="900" Height="640" MinWidth="580" MinHeight="410"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Closing="PythonPreviewWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock x:Name="DocumentNameText" Text="No Python file selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="390" VerticalAlignment="Center" />
                    <Border x:Name="StatusPill" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusIndicator" Width="8" Height="8" Fill="#808890" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Content="▶ Run" Style="{StaticResource AccentButton}" Click="Run_Click" ToolTip="Run the current Python file" />
                    <Button Content="■ Stop" Click="Stop_Click" ToolTip="Stop the Python preview process" />
                    <Button Content="↻ Restart" Click="Restart_Click" ToolTip="Stop and run the current Python file again" />
                    <Button Content="Clear" Click="Clear_Click" ToolTip="Clear output and errors" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="11,0">
            <DockPanel>
                <TextBlock Text="STANDARD OUTPUT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock x:Name="InterpreterText" Text="Python interpreter will be detected when Run is selected." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <TextBox x:Name="OutputBox" Grid.Row="2" Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalTextBrush}" BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12,8" />

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="4" Background="#301C1C" BorderBrush="#6C3636" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="31" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ERRORS" Foreground="#FFD7D7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0" />
                <TextBox x:Name="ErrorBox" Grid.Row="1" Background="Transparent" Foreground="#FFD7D7" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="12,4,12,8" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource AccentBrush}">
            <TextBlock x:Name="FooterText" Text="Python Live Preview is ready." Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
        </Border>
    </Grid>
</Window>
