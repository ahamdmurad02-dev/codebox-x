<Window x:Class="CodeBoxX.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About CodeBox X" Width="430" Height="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/CodeBoxX.png" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,12" />
            <TextBlock Text="CodeBox X" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" />
            <TextBlock Text="A local-first Windows development workspace." TextWrapping="Wrap" TextAlignment="Center" Width="300" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Update CodeBox X" Click="UpdateButton_Click" MinWidth="150" />
            <Button Content="Close" Click="CloseButton_Click" MinWidth="90" Margin="9,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
