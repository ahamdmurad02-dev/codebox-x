<Window x:Class="CodeBoxX.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CodeBox X — Live Preview" Width="980" Height="680" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Closing="PreviewWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="DocumentNameText" Text="No document selected" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <CheckBox x:Name="AutoRefreshBox" Content="Auto refresh" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ErrorPanel" Grid.Row="1" Background="#FFF4CE" BorderBrush="#D79E00" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="#6A4B00" TextWrapping="Wrap" />
        </Border>
        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="PreviewBrowser" Visibility="Collapsed" />
            <Border x:Name="EmptyPanel" Background="{DynamicResource EditorBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <TextBlock Text="Live Preview" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Open or create an HTML, Markdown, JSON, XML/XAML, or text file, then select Live Preview." Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource AccentBrush}">
            <TextBlock x:Name="PreviewStatusText" Text="Ready" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
        </Border>
    </Grid>
</Window>
