<Window x:Class="CodeBoxX.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeBox X - AI Settings" Width="550" Height="365" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="AI Settings" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Gemini 3.1 Flash-Lite" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0" /></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,0"><TextBlock Text="Gemini API key" FontWeight="SemiBold" /><Grid Margin="0,7,0,0"><PasswordBox x:Name="ApiKeyPasswordBox" Padding="8" /><TextBox x:Name="ApiKeyTextBox" Padding="8" Visibility="Collapsed" /></Grid><CheckBox x:Name="ShowKeyBox" Content="Show API key" Checked="ShowKeyBox_Changed" Unchecked="ShowKeyBox_Changed" Margin="0,7,0,0" /><TextBlock Text="The key is protected with Windows user-level data protection before it is saved locally. CodeBox X never writes it to chat, output, terminal, or logs." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0" /><TextBlock x:Name="StatusText" Text="No API key saved." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0" /></StackPanel>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button Content="Clear API Key" Click="Clear_Click" Margin="0,1,8,1" /><Button Content="Test Connection" Click="TestConnection_Click" Margin="0,1,8,1" /><Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0,1,8,1" /><Button Content="Close" IsCancel="True" Margin="0,1" /></WrapPanel>
    </Grid>
</Window>
