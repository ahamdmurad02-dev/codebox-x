<Window x:Class="CodeBoxX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeBox X" Height="780" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" AllowDrop="True"
        KeyDown="Window_KeyDown" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="0,0,1,0" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PanelBackgroundBrush}" /><Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,1,0" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="×" /><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="7,0,0,0" /><Setter Property="ToolTip" Value="Close tab" /></Style>
        <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="2" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="31" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="5" /><RowDefinition x:Name="OutputRow" Height="190" /><RowDefinition Height="25" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="CODEBOX X" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" /><TextBlock x:Name="ProjectTitleText" Grid.Column="1" Text="No project open" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0" /><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Run" Click="Run_Click" ToolTip="Run active file (F5)" /><Button Content="Restart" Click="Restart_Click" ToolTip="Restart the most recent active run (Ctrl+F5)" /><Button Content="Stop" Click="Stop_Click" ToolTip="Stop running process (Shift+F5)" /><Button Content="▶ Live Preview" Click="LivePreview_Click" ToolTip="Run Python files in the native preview panel or open the document preview" /><Button Content="Publish Website" Style="{StaticResource AccentButton}" Click="Publish_Click" ToolTip="Create a local deployable static website ZIP from the workspace" /><Button Content="MPM" Click="Mpm_Click" ToolTip="Open the project-aware package manager" /><Button Content="Marketplace" Click="Marketplace_Click" ToolTip="Browse the local offline catalog of themes, linters, and developer extensions" /><Button Content="AI Assistant" Click="AiAssistant_Click" ToolTip="Open Gemini AI Assistant" /><Button Content="Settings" Click="Settings_Click" ToolTip="Open settings" /></StackPanel></Grid></Border>
        <Menu Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="File"><MenuItem Header="New File" InputGestureText="Ctrl+N" Click="NewFile_Click" /><MenuItem Header="Open File..." InputGestureText="Ctrl+O" Click="OpenFile_Click" /><MenuItem Header="Open Folder..." InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click" /><MenuItem x:Name="RecentMenu" Header="Open Recent" SubmenuOpened="RecentMenu_SubmenuOpened" /><Separator /><MenuItem Header="Save" InputGestureText="Ctrl+S" Click="Save_Click" /><MenuItem Header="Save As..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" /><Separator /><MenuItem Header="Publish Website" Click="Publish_Click" /><Separator /><MenuItem Header="Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click" /><MenuItem Header="Exit" Click="Exit_Click" /></MenuItem>
            <MenuItem Header="Edit"><MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" /><MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" /><Separator /><MenuItem Header="Find / Replace" InputGestureText="Ctrl+H" Click="ToggleSearch_Click" /></MenuItem>
            <MenuItem Header="View"><MenuItem Header="File Explorer" Click="ToggleExplorer_Click" /><MenuItem Header="MPM Package Manager" Click="Mpm_Click" /><MenuItem Header="Marketplace" Click="Marketplace_Click" /><MenuItem Header="AI Assistant" Click="AiAssistant_Click" /><MenuItem Header="AI Settings" Click="AiSettings_Click" /><MenuItem Header="Output Panel" Click="ToggleOutput_Click" /><MenuItem Header="Problems" Click="ToggleProblems_Click" /><MenuItem Header="▶ Live Preview" Click="LivePreview_Click" /><MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreen_Click" /></MenuItem>
            <MenuItem Header="Terminal"><MenuItem Header="New Terminal" Click="NewTerminal_Click" /><MenuItem Header="Focus Terminal" InputGestureText="Ctrl+`" Click="FocusTerminal_Click" /><MenuItem Header="Clear Terminal" Click="ClearTerminal_Click" /></MenuItem>
            <MenuItem Header="Help"><MenuItem Header="Update CodeBox X" Click="UpdateCodeBoxX_Click" /><Separator /><MenuItem Header="Keyboard Shortcuts" Click="Shortcuts_Click" /><MenuItem Header="About CodeBox X" Click="About_Click" /></MenuItem>
        </Menu>
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0"><Button Content="New File" Click="NewFile_Click" ToolTip="Create a new unsaved document" /><Button Content="Open" Click="OpenFile_Click" ToolTip="Open a file" /><Button Content="Open Folder" Click="OpenFolder_Click" ToolTip="Open a workspace folder" /><Separator Width="12" Opacity="0" /><Button Content="Save" Click="Save_Click" ToolTip="Save active document" /><Button Content="Search" Click="ToggleSearch_Click" ToolTip="Find and replace" /><Button Content="AI" Click="AiAssistant_Click" ToolTip="Ask Gemini about selected code or the current project" /><Button Content="MPM" Click="Mpm_Click" ToolTip="Open the project-aware package manager" /><Button Content="Marketplace" Click="Marketplace_Click" ToolTip="Browse the local offline catalog of themes, linters, and developer extensions" /><Button Content="Publish Website" Style="{StaticResource AccentButton}" Click="Publish_Click" ToolTip="Create a local deployable static website ZIP from the workspace" /><Button Content="▶ Live Preview" Click="LivePreview_Click" ToolTip="Run Python files in the native preview panel or open the document preview" /><Separator Width="12" Opacity="0" /><Button Content="Run Active File" Style="{StaticResource AccentButton}" Click="Run_Click" ToolTip="Run the active file (F5)" /><Button Content="Restart" Click="Restart_Click" ToolTip="Restart the most recent active run (Ctrl+F5)" /><Button Content="Stop" Click="Stop_Click" ToolTip="Stop the active run (Shift+F5)" /></StackPanel></Border>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ExplorerColumn" Width="260" MinWidth="160" /><ColumnDefinition x:Name="ExplorerSplitterColumn" Width="5" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SettingsSplitterColumn" Width="0" /><ColumnDefinition x:Name="SettingsColumn" Width="0" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="41" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="10,0"><TextBlock Text="EXPLORER" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" /><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="+ File" Padding="6,3" Click="NewExplorerFile_Click" ToolTip="New file" /><Button Content="+ Folder" Padding="6,3" Click="NewExplorerFolder_Click" ToolTip="New folder" /><Button Content="Delete" Padding="6,3" Click="DeleteSelectedExplorerItem_Click" ToolTip="Delete selected file or folder" /><Button Content="Refresh" Padding="6,3" Click="RefreshExplorer_Click" ToolTip="Refresh explorer" /></StackPanel></DockPanel><TextBlock x:Name="ExplorerPathText" Grid.Row="1" Text="Open a folder to browse files" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="12,0,12,8" FontSize="11" /><TreeView x:Name="ExplorerTree" Grid.Row="2" Margin="5,0,5,6" SelectedItemChanged="ExplorerTree_SelectedItemChanged" MouseDoubleClick="ExplorerTree_MouseDoubleClick" /><Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="7"><StackPanel><Button Content="MPM" Click="Mpm_Click" ToolTip="Manage project packages and dependencies" HorizontalAlignment="Stretch" /><Button Content="Marketplace" Click="Marketplace_Click" ToolTip="Browse the local offline catalog of themes, linters, and developer extensions" HorizontalAlignment="Stretch" /><Button Content="Publish Website" Style="{StaticResource AccentButton}" Click="Publish_Click" ToolTip="Create a local deployable static website ZIP from the workspace" HorizontalAlignment="Stretch" Margin="0,6,0,0" /></StackPanel></Border></Grid></Border>
            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Column="2" Background="{DynamicResource EditorBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="SearchPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="9,7" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="FindBox" Margin="0,0,7,0" ToolTip="Find text" KeyDown="FindBox_KeyDown" /><TextBox x:Name="ReplaceBox" Grid.Column="1" Margin="0,0,7,0" ToolTip="Replace with" /><StackPanel Grid.Column="2" Orientation="Horizontal"><CheckBox x:Name="MatchCaseBox" Content="Match case" VerticalAlignment="Center" Margin="0,0,6,0" /><Button Content="Find Next" Click="FindNext_Click" /><Button Content="Replace All" Click="ReplaceAll_Click" /><Button Content="Close" Click="ToggleSearch_Click" /></StackPanel></Grid></Border>
                <Grid Grid.Row="1"><TabControl x:Name="OpenTabs" SelectionChanged="OpenTabs_SelectionChanged" Background="{DynamicResource EditorBackgroundBrush}" BorderThickness="0" /><Border x:Name="WelcomePanel" Background="{DynamicResource EditorBackgroundBrush}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460"><TextBlock Text="CodeBox X" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="A focused workspace for writing, running, and managing code." Foreground="{DynamicResource MutedTextBrush}" FontSize="14" TextAlignment="Center" Margin="0,12,0,20" TextWrapping="Wrap" /><WrapPanel HorizontalAlignment="Center"><Button Content="New File" Click="NewFile_Click" Margin="3" /><Button Content="Open File" Click="OpenFile_Click" Margin="3" /><Button Content="Open Folder" Style="{StaticResource AccentButton}" Click="OpenFolder_Click" Margin="3" /><Button Content="MPM" Click="Mpm_Click" Margin="3" /><Button Content="Marketplace" Click="Marketplace_Click" Margin="3" /><Button Content="Publish Website" Click="Publish_Click" Margin="3" /></WrapPanel><TextBlock x:Name="RecentHintText" Text="Recent files and projects are available from the File menu after you open them." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap" /></StackPanel></Border></Grid>
            </Grid>
            <GridSplitter x:Name="SettingsSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
            <Border x:Name="SettingsPanel" Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><DockPanel><TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" /><Button Content="Close" DockPanel.Dock="Right" Click="Settings_Click" /></DockPanel><TextBlock Text="Appearance" Margin="0,24,0,8" FontWeight="SemiBold" /><TextBlock Text="Theme" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" /><ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="0" Padding="6"><ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox><TextBlock Text="Editor font size" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,4" /><Slider x:Name="FontSizeSlider" Minimum="11" Maximum="22" Value="14" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged" /><TextBlock x:Name="FontSizeLabel" Text="14 px" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="Behavior" Margin="0,26,0,8" FontWeight="SemiBold" /><CheckBox x:Name="AutoSaveBox" Content="Auto-save open files" Checked="AutoSaveBox_Changed" Unchecked="AutoSaveBox_Changed" /><TextBlock Text="When enabled, a changed file is written automatically after a brief pause." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" /><TextBlock Text="About" Margin="0,26,0,8" FontWeight="SemiBold" /><TextBlock Text="CodeBox X v1.2.1 is a local-first Windows desktop editor. Files stay on your computer." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" /><Button Content="Update CodeBox X" Click="UpdateCodeBoxX_Click" HorizontalAlignment="Stretch" Margin="0,12,0,0" ToolTip="Check the official GitHub Releases for a verified CodeBox X update" /></StackPanel></ScrollViewer></Border>
        </Grid>
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <Border Grid.Row="5" Background="{DynamicResource TerminalBackgroundBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" LastChildFill="False"><TextBlock Text="TERMINAL" VerticalAlignment="Center" Margin="12,0" FontSize="12" FontWeight="SemiBold" DockPanel.Dock="Left" /><Button Content="Clear Terminal" Click="ClearTerminal_Click" Margin="0,3,6,3" DockPanel.Dock="Right" /><Button Content="New Terminal" Click="NewTerminal_Click" Margin="0,3,6,3" DockPanel.Dock="Right" /><Button Content="Hide" Click="ToggleOutput_Click" Margin="0,3,6,3" DockPanel.Dock="Right" /></DockPanel><TextBox x:Name="OutputBox" Grid.Row="1" Background="{DynamicResource TerminalBackgroundBrush}" Foreground="{DynamicResource TerminalTextBrush}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,6" /><DockPanel Grid.Row="2" Background="{DynamicResource TerminalBackgroundBrush}" Margin="8,0"><TextBlock Text="&gt;" Foreground="{DynamicResource TerminalTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="14" VerticalAlignment="Center" Margin="3,0,8,0" /><TextBox x:Name="TerminalCommandBox" Background="Transparent" Foreground="{DynamicResource TerminalTextBrush}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" KeyDown="TerminalCommandBox_KeyDown" VerticalContentAlignment="Center" ToolTip="Enter a Windows command and press Enter" /></DockPanel></Grid></Border>
        <Border x:Name="ProblemsPanel" Grid.Row="5" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel Grid.Row="0" Background="{DynamicResource SurfaceBrush}"><TextBlock Text="PROBLEMS" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" DockPanel.Dock="Left" /><Button Content="Terminal" Click="ToggleProblems_Click" Margin="0,3,7,3" DockPanel.Dock="Right" /></DockPanel><ListBox x:Name="ProblemsListBox" Grid.Row="1" Margin="7" BorderThickness="0" Background="Transparent" SelectionChanged="ProblemsListBox_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SeverityLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Location}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Row="6" Background="{DynamicResource AccentBrush}"><DockPanel Margin="10,0"><TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left" /><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock x:Name="LanguageStatusText" Text="Plain Text" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="12,0" /><TextBlock x:Name="CursorStatusText" Text="Ln 1, Col 1" Foreground="White" FontSize="11" VerticalAlignment="Center" /></StackPanel></DockPanel></Border>
    </Grid>
</Window>
