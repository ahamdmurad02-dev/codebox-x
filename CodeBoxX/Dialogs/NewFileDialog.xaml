<Window x:Class="CodeBoxX.Dialogs.NewFileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New File" Width="410" Height="220" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="File name" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="FileNameBox" Grid.Row="1" ToolTip="Example: app.py or notes" />
        <TextBlock Grid.Row="2" Text="File type" FontWeight="SemiBold" Margin="0,16,0,5" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="FileTypeBox" SelectedIndex="0" Padding="6" SelectionChanged="FileTypeBox_SelectionChanged">
                <ComboBoxItem Content="Plain Text (.txt)" Tag=".txt" />
                <ComboBoxItem Content="Python (.py)" Tag=".py" />
                <ComboBoxItem Content="C# (.cs)" Tag=".cs" />
                <ComboBoxItem Content="C++ (.cpp)" Tag=".cpp" />
                <ComboBoxItem Content="Java (.java)" Tag=".java" />
                <ComboBoxItem Content="JavaScript (.js)" Tag=".js" />
                <ComboBoxItem Content="TypeScript (.ts)" Tag=".ts" />
                <ComboBoxItem Content="JSON (.json)" Tag=".json" />
                <ComboBoxItem Content="XML (.xml)" Tag=".xml" />
                <ComboBoxItem Content="SQL (.sql)" Tag=".sql" />
                <ComboBoxItem Content="Lua (.lua)" Tag=".lua" />
                <ComboBoxItem Content="GDScript (.gd)" Tag=".gd" />
                <ComboBoxItem Content="Markdown (.md)" Tag=".md" />
            </ComboBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="78" />
                <Button Content="Create" Style="{StaticResource AccentButton}" Click="Create_Click" IsDefault="True" MinWidth="78" Margin="8,1,1,1" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
