<Window x:Class="CodeBoxX.Dialogs.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes" Width="440" Height="188" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Your changes will be lost if you do not save them." Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="82" />
            <Button Content="Don't Save" Click="DontSave_Click" MinWidth="92" Margin="8,1,1,1" />
            <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="82" Margin="8,1,1,1" />
        </StackPanel>
    </Grid>
</Window>
